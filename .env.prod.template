# ════════════════════════════════════════════════════════════════════
# PRODUCTION ENV — copy this file to `.env.prod` and fill the TODOs.
# KEEP SECRET. Do NOT commit `.env.prod` to git.
# ════════════════════════════════════════════════════════════════════

# ─── Database ───────────────────────────────────────────
# RECOMMENDED: Azure Database for PostgreSQL (Flexible Server) in the
# "South Africa North" region (POPIA data residency). Create the DB, then
# paste its connection string below (note: driver must be asyncpg, and Azure
# usually requires SSL).
POSTGRES_USER=ems_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=ems_claims
# If using Azure managed Postgres, replace this whole line with your Azure
# connection string, e.g.:
#   DATABASE_URL=postgresql+asyncpg://ems_admin:PASSWORD@YOURSERVER.postgres.database.azure.com:5432/ems_claims?ssl=require
# If self-hosting Postgres via docker-compose.db.yml on the same VM, leave as:
DATABASE_URL=postgresql+asyncpg://ems_admin:CHANGE_ME_STRONG_PASSWORD_HERE@ems_postgres:5432/ems_claims
# Set to 'require' for Azure PostgreSQL (enforces TLS + certificate verification)
# Leave empty for self-hosted Postgres on same VM without SSL.
DB_SSL_MODE=require

# ─── RabbitMQ / Celery ──────────────────────────────────
RABBITMQ_USER=ems_rabbit
RABBITMQ_PASS=CHANGE_ME_RABBIT_PASSWORD_HERE
# Single-VM: the backend reaches RabbitMQ via the Docker host gateway.
# (docker-compose.worker.yml publishes 5672 on the host — firewall it!)
CELERY_BROKER_URL=amqp://ems_rabbit:CHANGE_ME_RABBIT_PASSWORD_HERE@172.17.0.1:5672//
# Multi-VM: point at the worker VM's PRIVATE IP instead, e.g.
#   CELERY_BROKER_URL=amqp://ems_rabbit:...@10.0.0.5:5672//

# ─── JWT Auth ───────────────────────────────────────────
# Signs every access token, refresh token and crew device unlock. Anyone who
# knows this value can mint a token claiming any role, including SUPER_ADMIN.
# It must be unique per installation and never committed anywhere.
#
# Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The backend REFUSES TO START in production if this is left as a placeholder
# or is shorter than 32 characters (app/config.py).
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ─── Field encryption ───────────────────────────────────
# Set ONCE and NEVER change — anything encrypted under the old key becomes
# unreadable. Back this value up somewhere safe (a password manager).
#
# WHAT IT ACTUALLY PROTECTS TODAY: the per-provider SMTP app passwords used to
# email PRFs to receiving facilities. Patient ID numbers are NOT field-encrypted
# (the column is String(13), too small for a Fernet token) — they are protected
# by TLS to the database, storage-level encryption and access controls. Do not
# describe this key as encrypting patient data until that changes.
#
# Generate a real Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# A non-Fernet string will NOT error — app/utils/crypto.py deterministically
# derives a key from whatever you set, so a weak value silently "works". That is
# why production refuses placeholders and anything under 32 characters.
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY

# ─── External AI / OCR services (only if you use them) ───
CLAID_API_KEY=TODO_or_leave_blank
LLAMA_CLOUD_API_KEY=TODO_or_leave_blank
MISTRAL_API_KEY=TODO_or_leave_blank

# ─── File storage ───────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# ─── CORS / public URL ──────────────────────────────────
# MUST be your real HTTPS domain (see Azure_Deployment_Guide.md).
FRONTEND_URL=https://portal.emsmca.co.za
CORS_ORIGINS=https://portal.emsmca.co.za

# ─── Environment & Logging ──────────────────────────────
APP_ENV=production
LOG_LEVEL=WARNING
