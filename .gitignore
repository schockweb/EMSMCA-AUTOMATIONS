# ── Secrets & env files ──
.env
.env.prod
.env.dev
.env.local
*.env.local
*.pem
*.key
*.crt
!*.example

# ── Env backups with secrets ──
*.env.docker-backup
backend/.env.docker-backup

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.loadtest-venv/

# ── Node ──
node_modules/
frontend/dist/

# ── Uploads ──
uploads/

# ── Docker ──
docker-compose.override.yml

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db

# ── Alembic ──
alembic/versions/*.pyc

# ── Logs ──
*.log
logs/

# ── SSL certs ──
nginx/ssl/

# ── Windows specials ──
nul
*.sql

# Real-claims replay data — REAL PATIENT DATA, never commit (POPIA)
backend/golden_claims*.csv
backend/golden_claims*.json
backend/golden_claims_report*

# ── Database dumps / backups — NEVER commit these ─────────────────────────
# Two full PostgreSQL dumps containing user, crew, case and PRF tables were
# committed on 2026-05-28/06-01 and sat in a PUBLIC repo until 2026-07-27.
# They were purged from history; these rules stop a recurrence.
*.sql
*.sql.gz
*.dump
database_backup*
backup_*.sql
/backups/
# ...but real migration SQL must stay tracked:
!backend/migrations/*.sql
!backend/alembic/**/*.sql

# Container-side artefacts. `pip install` run inside the backend container
# writes into the bind-mounted /app, so these appear in the repo working tree
# without ever being part of the project. Committed by accident once (7f2e367).
backend/.cache/
backend/.local/
backend/vt.py
backend/probe.py

# ── SQLite databases — they carry bcrypt password hashes ──────────────────
# backend/ems.db and backend/ems.db.old were tracked from 2026-05-27 and held
# SUPER_ADMIN and ADMIN password hashes for the whole public-repo window. The
# app uses PostgreSQL; no SQLite file is ever a project asset.
*.db
*.db.old
*.sqlite
*.sqlite3

# ── Generated output and pasted scratch ───────────────────────────────────
# A 34 MB pasted traceback log was tracked and made up ~93% of all repo bloat.
global_errors.txt
debug_output.txt
*_dump.txt
patch.diff

# Load-test results are regenerated on every run and have no readers.
loadtest/results_*.csv
loadtest/*.html

# ── Test / coverage caches ────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
coverage/
htmlcov/
.coverage
frontend/coverage/

# Ad-hoc benchmark/repro scratch scripts — not part of the app
backend/bench*.py
backend/loopcheck.py
.env.loadtest.local
