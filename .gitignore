# ── Secrets & env files ──
.env
.env.prod
.env.dev
.env.local
*.env.local
*.pem
*.key
*.crt
!*.example

# ── Env backups with secrets ──
*.env.docker-backup
backend/.env.docker-backup

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.loadtest-venv/

# ── Node ──
node_modules/
frontend/dist/

# ── Uploads ──
uploads/

# ── Docker ──
docker-compose.override.yml

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db

# ── Alembic ──
alembic/versions/*.pyc

# ── Logs ──
*.log
logs/

# ── SSL certs ──
nginx/ssl/

# ── Windows specials ──
nul
*.sql

# Real-claims replay data — REAL PATIENT DATA, never commit (POPIA)
backend/golden_claims*.csv
backend/golden_claims*.json
backend/golden_claims_report*

# ── Database dumps / backups — NEVER commit these ─────────────────────────
# Two full PostgreSQL dumps containing user, crew, case and PRF tables were
# committed on 2026-05-28/06-01 and sat in a PUBLIC repo until 2026-07-27.
# They were purged from history; these rules stop a recurrence.
*.sql
*.sql.gz
*.dump
database_backup*
backup_*.sql
/backups/
# ...but real migration SQL must stay tracked:
!backend/migrations/*.sql
!backend/alembic/**/*.sql
