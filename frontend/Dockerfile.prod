# ═══════════════════════════════════════════════════════════
# EMS Claims Portal — Frontend Production Dockerfile
# Multi-stage build: Node build → Nginx serve
# Target: Azure VM (ems-portal-vm), served behind reverse proxy
# ═══════════════════════════════════════════════════════════

# ── Stage 1: Build ─────────────────────────────────────────
# Install deps and produce the Vite production bundle.
FROM node:22-slim AS build

WORKDIR /app

# Copy package manifests first for layer caching
COPY package.json package-lock.json ./

# Reproducible install — frozen lockfile, no optional audit noise
RUN npm ci --no-audit --no-fund

# Copy the rest of the source
COPY . .

# Build args — API URL and Maps key are baked into the bundle at build time
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

ARG VITE_GOOGLE_MAPS_KEY
ENV VITE_GOOGLE_MAPS_KEY=$VITE_GOOGLE_MAPS_KEY

# Increase heap size to prevent SIGBUS/OOM during heavy TS/Vite compilation
ENV NODE_OPTIONS="--max_old_space_size=4096"

# Produce optimised production build to /app/dist
RUN npm run build


# ── Stage 2: Serve with Nginx ─────────────────────────────
# Minimal alpine Nginx image — only static files, no Node runtime.
# nginx:1.27-alpine is ABANDONED upstream — re-pulling it in August 2026 still
# yields Alpine 3.21.3 with libcrypto3 3.3.3-r0, carrying CVE-2025-15467
# (OpenSSL RCE/DoS) and CVE-2026-31789. This container terminates TLS for
# portal.emsmca.co.za and is the only internet-reachable service on the box, so
# a stale OpenSSL here is the highest-value target in the whole deployment.
# 1.29-alpine is Alpine 3.23.4 with libcrypto3 3.5.6-r0, which fixes both.
#
# Pinned to a MINOR line, not `alpine`: the tag must be allowed to pick up
# patch rebuilds without a silent jump across a major nginx version. Re-check
# it whenever a scan flags this image — an abandoned tag fails silently, since
# `docker build --pull` cheerfully re-pulls the same stale layer.
FROM nginx:1.29-alpine AS serve

LABEL maintainer="EMS Claims Portal <admin@emsclaims.co.za>"
LABEL description="EMS Claims Portal — Frontend (production)"

# Take Alpine's current security patches, then remove the default site and
# create the snippets dir (needed for the security-headers.conf include).
#
# The base image is only rebuilt when nginx itself is released, so on any given
# day it lags Alpine's package repo. Pinning the base got this container from
# 35 HIGH/CRITICAL to 11; every one of the remaining 11 was a base package with
# a patch already published and simply not yet baked in — libssl3/libcrypto3
# (TLS) and nghttp2 (HTTP/2) among them, which is this container's actual
# attack surface. `apk upgrade` takes them to zero.
#
# This trades exact reproducibility for currency, deliberately: two builds of
# the same commit a month apart will not be byte-identical. For the only
# internet-reachable service in the deployment, shipping known-patched
# libraries is worth more than a reproducible hash — and releases are tagged as
# images (see deploy/scripts/tag-release.sh), so rollback still targets an
# exact artefact rather than a rebuild.
RUN apk upgrade --no-cache \
    && rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p /etc/nginx/snippets

# Copy built static assets from the build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom Nginx config (SPA routing, security headers, gzip)
# NOTE: In production, docker-compose.prod.yml volume-mounts
# nginx/nginx.conf over this file, so this is only a fallback.
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Health check — use 127.0.0.1 not localhost; Alpine's /etc/hosts may not
# resolve 'localhost' inside the container, causing spurious health failures.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
